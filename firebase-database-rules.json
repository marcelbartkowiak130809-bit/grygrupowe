{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "luckySpins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "honorVotes": {
      "$roomId": {
        "$fromUid": {
          ".read": false,
          ".write": false
        }
      }
    },
    "siteStats": {
      ".read": true,
      ".write": false
    },
    "siteStatEvents": {
      ".read": false,
      ".write": false
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": false,
        "nick": { ".write": "auth != null && auth.uid == $uid" },
        "avatarImage": { ".write": "auth != null && auth.uid == $uid" },
        "nickOnly": { ".write": "auth != null && auth.uid == $uid" },
        "adultStatus": { ".write": "auth != null && auth.uid == $uid" },
        "xp": { ".write": "auth != null && auth.uid == $uid" },
        "sessionXp": { ".write": "auth != null && auth.uid == $uid" },
        "selectedNickEffect": { ".write": "auth != null && auth.uid == $uid" },
        "selectedAvatarFrame": { ".write": "auth != null && auth.uid == $uid" },
        "selectedAura": { ".write": "auth != null && auth.uid == $uid" },
        "selectedCandySkin": { ".write": "auth != null && auth.uid == $uid" },
        "selectedBombSkin": { ".write": "auth != null && auth.uid == $uid" },
        "selectedClockSkin": { ".write": "auth != null && auth.uid == $uid" },
        "selectedIdleAnimation": { ".write": "auth != null && auth.uid == $uid" },
        "selectedWinAnimation": { ".write": "auth != null && auth.uid == $uid" },
        "selectedLoseAnimation": { ".write": "auth != null && auth.uid == $uid" },
        "privacy": { ".write": "auth != null && auth.uid == $uid" },
        "updatedAt": { ".write": "auth != null && auth.uid == $uid" },
        "gameHistory": { ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('profiles').child($uid).child('privacy').child('historyPublic').val() == true)" },
        "gameStats": { ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('profiles').child($uid).child('privacy').child('statsPublic').val() == true)" },
        "stats": { ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('profiles').child($uid).child('privacy').child('statsPublic').val() == true)" },
        "friends": { ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('profiles').child($uid).child('privacy').child('friendsPublic').val() == true)" }
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid == $targetUid",
        "$requestId": {
          ".read": "auth != null && (auth.uid == $targetUid || data.child('fromUid').val() == auth.uid)",
          ".write": "auth != null && ((auth.uid == $targetUid && newData.child('toUid').val() == $targetUid) || (newData.child('fromUid').val() == auth.uid && newData.child('toUid').val() == $targetUid) || (!newData.exists() && (auth.uid == $targetUid || data.child('fromUid').val() == auth.uid)))"
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        "clients": {
          "$clientId": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['seenAt'])"
          }
        }
      }
    },
    "voiceSignaling": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
        "$fromUid": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && root.child('rooms').child($roomId).child('players').child($fromUid).exists()",
          "$toUid": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && root.child('rooms').child($roomId).child('players').child($fromUid).exists() && root.child('rooms').child($roomId).child('players').child($toUid).exists()"
          }
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('players').child(auth.uid).exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('players').child(auth.uid).exists()) || (data.exists() && data.child('status').val() == 'lobby' && newData.child('status').val() == 'lobby' && newData.child('players').child(auth.uid).exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['roomId', 'gameMode', 'hostUid', 'players', 'status', 'createdAt', 'updatedAt']) && newData.child('roomId').val() == $roomId && (newData.child('status').val() == 'lobby' || newData.child('status').val() == 'playing' || newData.child('status').val() == 'results'))"
      }
    },
    "shop": {
      ".read": true,
      ".write": false
    },
    "wouldYouRatherVotes": {
      ".read": true,
      "$questionId": {
        "$choice": {
          ".write": "($choice == 'a' || $choice == 'b') && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "pollVotes": {
      "$pollId": {
        "$voterKey": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.isString() && (newData.val() == 'cosmetics' || newData.val() == 'new-mode' || newData.val() == 'questions')"
        }
      }
    },
    "pollResults": {
      ".read": true,
      "$pollId": {
        "$optionId": {
          ".write": "auth != null && ($optionId == 'cosmetics' || $optionId == 'new-mode' || $optionId == 'questions') && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    }
  }
}
